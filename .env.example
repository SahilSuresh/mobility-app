# Copy this file to .env.local and fill in your RevenueCat public SDK keys (RevenueCat > Project settings > API keys).
# These are public keys, safe to ship in the app. Never put a secret key (sk_...) here.

# Test Store key (starts with test_). Development builds use it in place of the two below, so purchases work
# end to end without the App Store or Google Play. Release builds ignore it.
EXPO_PUBLIC_REVENUECAT_TEST_KEY=

# Real store keys (appl_... and goog_...), for TestFlight, Play testing and release builds.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# With no keys at all, a development build runs the paywall in test mode (example prices, no payment taken).
